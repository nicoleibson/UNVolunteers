# ============================================================
# Project Lifeline Core — plantilla de configuración (.env.example)
# Copia este archivo a `.env` y completa con tus valores.
# NUNCA subas `.env` al repositorio (ver .gitignore).
# ------------------------------------------------------------
# Convención: prefijo LIFELINE_ para variables del proyecto.
# El servidor las lee al arrancar (`node server.js`); la GUI de
# mando usa parámetros de URL, ver README_DEPLOY.
# ============================================================

# ── Servidor / gateway de borde ─────────────────────────────
# Puerto HTTP del servidor (por defecto 8000).
# Soportado hoy por simulation/simulation/server.js.
PORT=8000

# Identificador de red de la malla (todos los dispositivos que
# deben interoperar usan el mismo networkId).
LIFELINE_NETWORK_ID=LIFELINE-001

# Identificador único de este dispositivo/gateway en la red.
#LIFELINE_INSTANCE_ID=

# Nombre visible de este nodo en la malla/consola.
#LIFELINE_LABEL=SERVIDOR-LOCAL

# Puerto de descubrimiento UDP entre gateways (broadcast LAN).
#LIFELINE_DISCOVERY_PORT=42203

# --- Seguridad / cifrado de enlace (AES-128-CTR) ─────────────
# Clave AES-128 maestra en hex (32 caracteres, 16 bytes) usada
# para cifrar la telemetría en el enlace RF/malla y el store
# DTN en reposo.
# ⚠ GENERA UNA CLAVE PRIVADA PROPIA. La clave de ejemplo de la
#   referencia NIST (packet_encoder.js) es SOLO DEMO y NO debe
#   usarse en operaciones reales.
# Generación (sin dependencias):
#   node -e "console.log(crypto.randomBytes(16).toString('hex'))"
LIFELINE_AES_KEY=00000000000000000000000000000000

# Indicativo APRS del operador (p. ej. un indicativo de
# radioaficionado). Sin valor, APRS queda inactivo (no usa N0CALL).
#LIFELINE_CALLSIGN=

# --- Recolectores de telemetría (opcional) ───────────────────
# Si más adelante se envían tramas a un concentrador externo,
# se inyectan aquí los tokens. Requerir autenticación solo de
# quien lo necesite.
#LIFELINE_RELAY_PEERS_URL=